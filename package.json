{
  "name": "merobaron",
  "version": "0.1.0",
  "description": "Guía abierta para saber qué hacer después de un robo: bloqueos, claves y denuncia, sin registro.",
  "scripts": {
    "test": "vitest run",
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "pnpm tokens && astro dev",
    "build": "pnpm tokens && astro check && astro build",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merobaron/merobaron.git"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "bugs": {
    "url": "https://github.com/merobaron/merobaron/issues"
  },
  "homepage": "https://github.com/merobaron/merobaron#readme",
  "dependencies": {
    "@astrojs/vue": "7.1.2",
    "@fontsource/anton": "5.3.0",
    "@fontsource/archivo": "5.3.0",
    "astro": "7.4.5",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "private": true,
  "engines": {
    "node": "^26"
  },
  "packageManager": "pnpm@12.9.0"
}
